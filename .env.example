# 아래 값은 모두 선택 사항입니다. .env 파일 자체가 없어도 사이트는 정상 동작합니다.

# 기수 구분용 키(로컬 저장소 파티션 키로만 쓰임). URL의 ?c= 쿼리로도 덮어쓸 수 있습니다.
VITE_DEFAULT_CID=season-1

# --- 아래는 Firebase 백엔드로 전환할 때만 필요합니다. README "선택: Firebase로 전환하기" 참고 ---

# Firebase 콘솔 > 프로젝트 설정 > 일반 > 내 앱(웹)에서 복사하세요.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# true로 설정하면 로컬 Firebase 에뮬레이터(auth/firestore/storage)에 연결합니다.
VITE_USE_FIREBASE_EMULATOR=false
